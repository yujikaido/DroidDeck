#!/bin/bash
dir=/usr/share/droiddeck/pacman
state=/root/.local/share/droiddeck/pacman
mkdir -p "$state"
/usr/bin/pacman --config "$dir/pacman.conf" -Qqe 2>/dev/null | grep -vxF -f "$dir/system-packages.txt" > "$state/packages.txt.tmp"
mv -f "$state/packages.txt.tmp" "$state/packages.txt"
[ -s "$state/restored" ] || sha256sum "$dir/droiddeck.db" | cut -d' ' -f1 > "$state/restored"
rm -f /var/cache/pacman/pkg/*.pkg.tar.* /var/cache/pacman/pkg/*.pkg.tar.*.sig 2>/dev/null
exit 0
